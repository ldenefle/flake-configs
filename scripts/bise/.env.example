# --- Tailscale ---
# Auth key used to register bise on the tailnet.
# Generate one at https://login.tailscale.com/admin/settings/keys
TAILSCALE_KEY="tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Transmission ---
TRANSMISSION_RPC_PASSWORD="your-transmission-rpc-password"

# --- Navidrome ---
SPOTIFY_ID="your-spotify-client-id"
SPOTIFY_SECRET="your-spotify-client-secret"

LASTFM_APIKEY="your-lastfm-api-key"
LASTFM_SECRET="your-lastfm-secret"

# --- Icecast (radio role) ---
# Password liquidsoap uses to push the audio stream to icecast.
# Must match the <source-password> in icecast.xml.
ICECAST_SOURCE_PASSWORD="your-icecast-source-password"

# Password used by icecast relay nodes to pull the stream.
ICECAST_RELAY_PASSWORD="your-icecast-relay-password"

# Password for the icecast web admin interface (port 8000/admin).
ICECAST_ADMIN_PASSWORD="your-icecast-admin-password"
